{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "site",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8000"
      ],
      "port": 8000
    },
    {
      "name": "night",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8199",
        "--directory",
        ".claude/worktrees/staging"
      ],
      "port": 8199
    },
    {
      "name": "tombot",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "-u",
        "ANTHROPIC_API_KEY",
        "netlify",
        "dev",
        "--port",
        "8888"
      ],
      "port": 8888
    }
  ]
}