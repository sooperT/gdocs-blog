# Every variable the Netlify functions and scripts read. Copy to .env (production
# values, local `netlify dev`) or .env.staging (staging values). No real values here.
# On Netlify, secrets are set per deploy context in the UI, never in netlify.toml.

# Postgres URL of the TomBot database. Read by every function (chat, ask, calibrate,
# agent-fetch) and by scripts/load_content_v3.py. Production context: the database
# named "niledb". Branch-deploy / deploy-preview: the staging database (name must
# contain "staging"); .env.staging holds the staging NILEDB_URL for local use.
NILEDB_URL=postgres://USER:PASSWORD@HOST:5432/DATABASE

# Voyage AI key for query embeddings. Read by chat, ask (?q=), calibrate (briefs) and
# the content loader. Same key in every context unless Tom splits them.
VOYAGE_API_KEY=

# Anthropic key. Read by chat (every reply) and calibrate (brief splitter; without it
# the heuristic splitter is used). Never read by ask ?q=. All contexts.
ANTHROPIC_API_KEY=

# production | staging. Which database rule lib/db_env.js enforces for ask and
# calibrate. Set per context in netlify.toml (production / branch-deploy /
# deploy-preview). Unset: falls back to Netlify's CONTEXT, else production.
TOMBOT_ENV=

# false or 0 switches /ask and /ask/brief off (503) in that context; unset = on.
# Read by ask and calibrate only, never chat. Set per context in the Netlify UI.
AGENT_SIDE_ENABLED=
